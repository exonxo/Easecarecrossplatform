# API base URL — relative (same-origin via the GCP Load Balancer host web.ease-care.app).
# Local dev against a local backend: keep /api/v1 and use the Vite dev proxy (vite.config.ts),
# or set an absolute URL like http://localhost:8000/api/v1.
VITE_API_BASE_URL=/api/v1

# Firebase Phone Auth (OTP). Reuse the ease-care-app project; the web client API key is a
# public identifier, not a secret. web.ease-care.app must be an authorized domain in Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ease-care-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ease-care-app

# Set to "true" to use the local-only mock data service (localStorage, no backend). Default false.
VITE_USE_MOCK=false
